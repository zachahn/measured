#!/usr/bin/env python3
"""Read and write this repo's measured settings.

Settings live in one JSON file per repo, namespaced by working directory the
same way `measured-notes` namespaces its plan dirs. They are shared across
every Claude session in the repo and persist between them. The file is not
committed to the repo.

  (no arguments)        print every setting as JSON
  --get KEY             print one setting's value (nothing if unset)
  --set KEY VALUE       set one setting and print the new full settings
  --unset KEY           remove one setting and print the new full settings

Known settings:

  worktree-setup        shell commands to run after creating a worktree to get
                        it ready to work in (install deps, build, etc.)
  work-location         where the implement skill runs its work: "ask",
                        "worktree", "new-branch", "current-branch", or
                        "trunk-branch".
  docs-location         where measured stores plan docs (ARCHITECTURE.md,
                        TICKET.md, etc.). Required by measured-notes.
                        "XDG_STATE_HOME" stores them in the default state dir
                        (~/.local/state/…). "REPO: <path/to/docs>" stores them
                        in a subdirectory of the project repo.

Commit settings, stated to Claude on every prompt by the measured-behavior
plugin's commit-settings hook:

  commit-behavior       when to commit: "after-every-turn" or "on-user-request".
  commit-location       which branch to commit to: "current-branch", which
                        includes committing to main, "new-branch", or "ask".
  commit-style          how to word a subject: "imperative" or "conventional".
  commit-scope          how much goes in one commit: "per-task", "per-file", or
                        "squash-all".
  commit-body           when a commit needs a body: "always", "when-nontrivial",
                        or "never".
  commit-claude-attribution
                        whether to add Co-Authored-By/Claude-Session trailers:
                        "true" or "false".
  commit-settings-for-subagents
                        whether spawned subagents get these settings appended
                        to their prompt: "true" or "false". Off unless "true".

The vocabulary for those values lives in the measured-behavior plugin, at
lib/behavior_settings.py. Any other value is passed through verbatim.

Path/state resolution lives in ../lib/session_lib.py.
"""

import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))
import session_lib  # noqa: E402


HELP_TEXT = """\
usage: measured-config [--get KEY | --set KEY VALUE | --unset KEY]

Read and write this repo's measured settings.

Settings are shared across every Claude session in the repo and persist
between them. They are stored outside the repo and are not committed.

  (no arguments)        print every setting as a JSON object
  --get KEY             print one setting's value (nothing if unset)
  --set KEY VALUE       set one setting, then print the full settings object
  --unset KEY           remove one setting, then print the full settings object

Known settings:

  worktree-setup        shell commands to run after creating a worktree to get
                        it ready to work in (install deps, build, etc.)
  work-location         where the implement skill runs its work: "ask",
                        "worktree", "new-branch", "current-branch", or
                        "trunk-branch".
  docs-location         where measured stores plan docs (ARCHITECTURE.md,
                        TICKET.md, etc.). Required by measured-notes.
                        "XDG_STATE_HOME" stores them in the default state dir
                        (~/.local/state/…). "REPO: <path/to/docs>" stores them
                        in a subdirectory of the project repo.

Commit settings. The measured-behavior plugin states these to Claude on every
prompt, so they govern every commit in the repo, not just the implement skill.
Each accepts a free-text value, passed through verbatim, when none of the
listed values fit.

  commit-behavior       when to commit: "after-every-turn" or "on-user-request".
  commit-location       which branch to commit to: "current-branch" (commit to
                        the checked-out branch, including main), "new-branch",
                        or "ask".
  commit-style          how to word a subject: "imperative" or "conventional".
  commit-scope          how much goes in one commit: "per-task", "per-file", or
                        "squash-all".
  commit-body           when a commit needs a body: "always", "when-nontrivial",
                        or "never".
  commit-claude-attribution
                        whether to add Co-Authored-By/Claude-Session trailers:
                        "true" or "false".
  commit-settings-for-subagents
                        whether spawned subagents get these settings appended
                        to their prompt: "true" or "false". Off unless "true".
"""


class _Parser(argparse.ArgumentParser):
    def format_help(self) -> str:
        return HELP_TEXT

    def format_usage(self) -> str:
        return "usage: measured-config [--get KEY | --set KEY VALUE | --unset KEY]\n"


def main(argv: list[str]) -> int:
    parser = _Parser(prog="measured-config", add_help=False)
    parser.add_argument("-h", "--help", action="help")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--get", metavar="KEY")
    group.add_argument("--set", nargs=2, metavar=("KEY", "VALUE"))
    group.add_argument("--unset", metavar="KEY")

    args = parser.parse_args(argv)

    repo = session_lib.repo_dir()

    try:
        if args.get is not None:
            value = session_lib.get_setting(repo, args.get)
            if value is not None:
                print(value)
            return 0

        if args.set is not None:
            key, value = args.set
            settings = session_lib.set_setting(repo, key, value)
            print(json.dumps(settings, indent=2))
            return 0

        if args.unset is not None:
            settings = session_lib.set_setting(repo, args.unset, None)
            print(json.dumps(settings, indent=2))
            return 0

        print(json.dumps(session_lib.load_settings(repo), indent=2))
        return 0
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

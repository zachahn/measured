{
  "name": "measured-behavior",
  "description": "Behavior plugin for Claude Code",
  "version": "1.3.19",
  "author": {
    "name": "Zach Ahn",
    "email": "measured-dev@zachahn.com"
  },
  "homepage": "https://github.com/zachahn/measured",
  "repository": "https://github.com/zachahn/measured",
  "license": "MIT",
  "keywords": [
    "behavior"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-config.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/reminders-every-turn.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/writing-clearly.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/reminders-session-start.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/setup-notice.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/writing-clearly.py"
          }
        ]
      }
    ]
  }
}

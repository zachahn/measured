{
  "name": "measured-behavior",
  "description": "Behavior plugin for Claude Code",
  "version": "1.3.11",
  "author": {
    "name": "Zach Ahn",
    "email": "measured-dev@zachahn.com"
  },
  "homepage": "https://github.com/zachahn/measured",
  "repository": "https://github.com/zachahn/measured",
  "license": "MIT",
  "keywords": [
    "behavior"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/commit-settings-for-agents.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-config.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/style.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/commit-settings.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/writing-clearly.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/commit-settings-help.py"
          }
        ]
      }
    ]
  }
}
